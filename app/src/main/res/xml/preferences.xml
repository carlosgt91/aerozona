<?xml version="1.0" encoding="utf-8"?>
<!--
    AirAware keeps its settings on the pane, next to what they affect. This
    screen exists so the manual has somewhere to be reached from: ATAK surfaces
    a plugin's documentation through its Tool Preferences entry, and without
    one the PDF ships inside the APK with no way for anyone to open it.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/aemet_category">

        <com.atakmap.android.gui.PanEditTextPreference
            android:key="aerozona_aemet_key"
            android:title="@string/aemet_key_title"
            android:summary="@string/aemet_key_summary"
            android:singleLine="true"
            android:inputType="textNoSuggestions" />

        <com.atakmap.android.gui.PanPreference
            android:key="aemet_guide"
            android:title="@string/aemet_guide_title"
            android:summary="@string/aemet_guide_summary" />

    </PreferenceCategory>

    <com.atakmap.android.gui.PanPreference
        android:key="manual"
        android:title="@string/manual_title"
        android:summary="@string/manual_summary" />

</PreferenceScreen>
